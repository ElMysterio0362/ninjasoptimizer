<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base: preto com superfícies levemente elevadas -->
    <Color x:Key="BgColor">#000000</Color>
    <Color x:Key="SurfaceColor">#0C0B12</Color>
    <Color x:Key="Surface2Color">#14121D</Color>
    <Color x:Key="BorderColor">#221E30</Color>

    <!-- Destaque #44088c e tons derivados -->
    <Color x:Key="AccentColor">#44088C</Color>
    <Color x:Key="AccentDarkColor">#2A0558</Color>
    <Color x:Key="AccentMidColor">#5F16B8</Color>
    <Color x:Key="AccentLightColor">#8B45E0</Color>
    <Color x:Key="AccentTextColor">#B58CF2</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentMidBrush" Color="{StaticResource AccentMidColor}" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2244088C" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3344088C" />

    <SolidColorBrush x:Key="TextBrush" Color="#F2F0F7" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#9A95AB" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="#615C72" />

    <!-- Estados -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#3DDC97" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFB547" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF5C7A" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1A3DDC97" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#1AFFB547" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#1AFF5C7A" />

    <!-- Gradientes -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#44088C" Offset="0" />
        <GradientStop Color="#7B2FF7" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5410AA" Offset="0" />
        <GradientStop Color="#8E4BFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2A0558" Offset="0" />
        <GradientStop Color="#120424" Offset="0.55" />
        <GradientStop Color="#0C0B12" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0A0612" Offset="0" />
        <GradientStop Color="#050308" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BarGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#44088C" Offset="0" />
        <GradientStop Color="#9B5CFF" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
</ResourceDictionary>
