<Window x:Class="NinjasOptimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NinjasOptimizer.App.ViewModels"
        xmlns:views="clr-namespace:NinjasOptimizer.App.Views"
        Title="Ninjas Optimizer" Width="1280" Height="800" MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        Icon="Assets/app.ico" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OptimizeViewModel}"><views:OptimizeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HardwareViewModel}"><views:HardwareView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}"><views:PlaceholderView /></DataTemplate>

        <DataTemplate x:Key="NavTemplate" DataType="{x:Type vm:NavItem}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Width="28" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="NavList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource NavButton}" />
            <Setter Property="ItemTemplate" Value="{StaticResource NavTemplate}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
    </Window.Resources>

    <!-- Margem extra quando maximizado (WindowChrome estende além da tela) -->
    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ───────── Barra lateral ───────── -->
        <Border Background="{StaticResource SidebarGradient}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,14,14,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,4,0,26">
                    <Image Source="Assets/logo.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Ninjas" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="15" />
                        <TextBlock Text="OPTIMIZER" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" Margin="0,-2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding FooterItems}"
                             SelectedItem="{Binding Current, Mode=TwoWay}" />
                    <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="8" Background="{StaticResource Surface2Brush}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsElevated}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Margin="8,0,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Modo usuário" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsElevated}" Value="True">
                                                <Setter Property="Text" Value="Modo administrador" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding Current, Mode=TwoWay}" />
            </DockPanel>
        </Border>

        <!-- ───────── Conteúdo ───────── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Brilho sutil do destaque no topo -->
            <Border Grid.RowSpan="2" Height="260" VerticalAlignment="Top" IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush Center="0.85,0" GradientOrigin="0.85,0" RadiusX="0.6" RadiusY="1">
                        <GradientStop Color="#2644088C" Offset="0" />
                        <GradientStop Color="#0044088C" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimizar" />
                <Button Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" ToolTip="Maximizar" />
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="Fechar" />
            </StackPanel>

            <ContentControl x:Name="PageHost" Grid.Row="1" Margin="36,0,28,24" Focusable="False"
                            Content="{Binding Current.Page, NotifyOnTargetUpdated=True}">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="PageOffset" />
                </ContentControl.RenderTransform>
                <ContentControl.Triggers>
                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                                <DoubleAnimation Storyboard.TargetName="PageOffset" Storyboard.TargetProperty="Y" From="14" To="0" Duration="0:0:0.3">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </ContentControl.Triggers>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
