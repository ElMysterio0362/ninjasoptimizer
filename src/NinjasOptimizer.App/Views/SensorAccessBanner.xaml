<UserControl x:Class="NinjasOptimizer.App.Views.SensorAccessBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext: LiveSensors -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Border Visibility="{Binding ShowAccessBanner, Converter={StaticResource BoolToVis}}"
            Background="{StaticResource WarningSoftBrush}" BorderBrush="#33FFB547" BorderThickness="1"
            CornerRadius="10" Padding="14,10">
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Button Style="{StaticResource ChipButton}" Margin="0" Content="Reabrir como administrador"
                        Command="{Binding ElevateCommand}" Visibility="{Binding CanElevate, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource ChipButton}" Margin="0" Content="Instalar driver PawnIO"
                        Command="{Binding InstallDriverCommand}" Visibility="{Binding CanInstallDriver, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <TextBlock Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource WarningBrush}" Text="&#xE7BA;" Margin="0,0,10,0" />
            <TextBlock Style="{StaticResource Body}" FontSize="12" VerticalAlignment="Center" Text="{Binding AccessMessage}" />
        </DockPanel>
    </Border>
</UserControl>
