<UserControl x:Class="NinjasOptimizer.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource H1}" Text="Configurações" />
            <TextBlock Style="{StaticResource Muted}" Text="Segurança, permissões e dados do aplicativo." Margin="0,4,0,22" />

            <!-- Segurança -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" FontSize="14" Text="Segurança" Margin="0,0,0,16" />
                    <DockPanel Style="{StaticResource Row}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CreateRestorePoint}" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="Criar ponto de restauração antes de otimizar" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="Recomendado. Permite voltar o Windows inteiro ao estado anterior pelo 'Restaurar sistema'." />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}" Margin="0">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AbortIfRestorePointFails}" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="Cancelar se o ponto de restauração falhar" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="Se desligado, o app segue com o backup do registro e o histórico de desfazer." />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Permissões -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <DockPanel>
                    <Button DockPanel.Dock="Right" VerticalAlignment="Center"
                            Content="Reabrir como administrador" Command="{Binding RelaunchElevatedCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsElevated}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" FontSize="14" Text="Permissões" />
                        <TextBlock Style="{StaticResource Body}" Text="{Binding ElevationText}" Margin="0,8,0,0" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"
                                   Text="O app roda como usuário comum e só pede administrador quando você aplica algo que precisa. Executar como administrador também libera as temperaturas de CPU e discos." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Hardware manual -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" FontSize="14" Text="Fonte de alimentação" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,10"
                               Text="A fonte não é detectável por software. Informe modelo e potência (ex.: Corsair RM750x 750W) para a análise de gargalos." />
                    <TextBox Text="{Binding PowerSupply, UpdateSourceTrigger=LostFocus}" MaxWidth="420" HorizontalAlignment="Left" Width="420" />
                </StackPanel>
            </Border>

            <!-- Dados -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" FontSize="14" Text="Dados e backups" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,12"
                               Text="Os backups .reg podem ser importados manualmente (duplo clique) em último caso. O histórico de alterações fica em journal.json." />
                    <WrapPanel>
                        <Button Style="{StaticResource ChipButton}" Content="Abrir pasta de backups" Command="{Binding OpenBackupsCommand}" />
                        <Button Style="{StaticResource ChipButton}" Content="Abrir pasta de dados" Command="{Binding OpenDataCommand}" />
                        <Button Style="{StaticResource ChipButton}" Content="Abrir log de hoje" Command="{Binding OpenLogCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Caption}" Text="{Binding Version, StringFormat='NINJAS OPTIMIZER v{0}'}" Margin="2,6,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
