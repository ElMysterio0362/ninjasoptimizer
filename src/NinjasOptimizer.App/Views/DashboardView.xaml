<UserControl x:Class="NinjasOptimizer.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NinjasOptimizer.App.Controls"
             xmlns:local="clr-namespace:NinjasOptimizer.App.Views">
    <UserControl.Resources>
        <!-- Card de métrica ao vivo com sparkline -->
        <Style x:Key="LiveCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="Padding" Value="18,16,18,0" />
        </Style>
        <!-- Card de resumo do sistema -->
        <DataTemplate x:Key="SummaryTemplate">
            <Border Style="{StaticResource Card}" Margin="0,0,14,14" Padding="16">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource Icon}" HorizontalAlignment="Center" Text="{Binding Glyph}" />
                    </Border>
                    <StackPanel Margin="14,0,0,0">
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Caption}" />
                        <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Title}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="{Binding Detail}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
            <TextBlock Style="{StaticResource H1}" Text="Dashboard" />
            <TextBlock Style="{StaticResource Muted}" Text="Visão geral do seu PC e do estado das otimizações." Margin="0,4,0,22" />

            <!-- ───────── Hero: otimização rápida ───────── -->
            <Border CornerRadius="16" Background="{StaticResource HeroGradient}" BorderBrush="#3344088C" BorderThickness="1" Padding="28,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Anel de progresso das otimizações -->
                    <Grid Width="96" Height="96">
                        <Ellipse Stroke="#22FFFFFF" StrokeThickness="8" />
                        <c:ProgressRing Value="{Binding OptimizationScore}" Thickness="8" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Metric}">
                                <Run Text="{Binding Applied, Mode=OneWay}" /><Run Text="/" Foreground="{StaticResource TextMutedBrush}" /><Run Text="{Binding Total, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" />
                            </TextBlock>
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Caption}" Text="ATIVAS" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="26,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource H2}" FontSize="20" Text="Otimização rápida" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" MaxWidth="520" HorizontalAlignment="Left"
                                   Text="Aplica o perfil Equilibrado: ajustes de baixo risco com ganho real, sempre com ponto de restauração e backup do registro. Você revisa a lista antes de confirmar." />
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Padding="26,13" VerticalAlignment="Center"
                            Command="{Binding QuickOptimizeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Foreground="White" Text="&#xE945;" Margin="0,0,10,0" />
                            <TextBlock Text="Otimizar agora" FontSize="14" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ───────── Tempo real ───────── -->
            <TextBlock Style="{StaticResource Caption}" Text="TEMPO REAL" Margin="0,26,0,10" />
            <local:SensorAccessBanner DataContext="{Binding Live}" Margin="0,0,0,12" />
            <Grid DataContext="{Binding Live}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource LiveCard}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="12" Text="{Binding CpuTempText}" />
                            <TextBlock Style="{StaticResource Caption}" Text="CPU" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Metric}" Text="{Binding CpuLoadText}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="{Binding CpuClockText}" />
                        <c:Sparkline Values="{Binding CpuHistory}" Height="54" Margin="-18,10,-18,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource LiveCard}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="12" Text="{Binding GpuTempText}" />
                            <TextBlock Style="{StaticResource Caption}" Text="GPU" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Metric}" Text="{Binding GpuLoadText}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="{Binding VramText, StringFormat='VRAM {0}'}" />
                        <c:Sparkline Values="{Binding GpuHistory}" Height="54" Margin="-18,10,-18,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource LiveCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="MEMÓRIA" />
                        <TextBlock Style="{StaticResource Metric}" Text="{Binding RamLoadText}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="{Binding RamText}" />
                        <c:Sparkline Values="{Binding RamHistory}" Height="54" Margin="-18,10,-18,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ───────── Resumo do sistema ───────── -->
            <TextBlock Style="{StaticResource Caption}" Text="SEU SISTEMA" Margin="0,26,0,10" />
            <ItemsControl ItemsSource="{Binding Summary}" ItemTemplate="{StaticResource SummaryTemplate}" Margin="0,0,-14,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
