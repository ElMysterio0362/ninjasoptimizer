<UserControl x:Class="NinjasOptimizer.App.Views.OptimizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:opt="clr-namespace:NinjasOptimizer.Core.Optimization;assembly=NinjasOptimizer.Core"
             xmlns:c="clr-namespace:NinjasOptimizer.App.Controls"
             xmlns:safety="clr-namespace:NinjasOptimizer.Core.Safety;assembly=NinjasOptimizer.Core"
            >
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- ───────── Card de uma otimização ───────── -->
        <DataTemplate x:Key="TweakTemplate">
            <Border x:Name="CardBorder" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="14" Text="{Binding Name}" />
                            <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Background="{StaticResource SuccessSoftBrush}"
                                    Visibility="{Binding IsApplied, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="10" Foreground="{StaticResource SuccessBrush}" Text="&#xE73E;" Margin="0,0,5,0" />
                                    <TextBlock Style="{StaticResource BadgeText}" Foreground="{StaticResource SuccessBrush}" Text="{Binding AppliedText}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding Description}" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE945;" Margin="0,0,6,0" />
                            <TextBlock Style="{StaticResource Body}" FontSize="12" Foreground="{StaticResource AccentTextBrush}" Text="{Binding Benefit}" />
                        </StackPanel>

                        <WrapPanel Margin="0,12,0,0">
                            <!-- Risco -->
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Risk}" Value="{x:Static opt:RiskLevel.Medium}">
                                                <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Risk}" Value="{x:Static opt:RiskLevel.High}">
                                                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding RiskText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Risk}" Value="{x:Static opt:RiskLevel.Medium}">
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Risk}" Value="{x:Static opt:RiskLevel.High}">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource Badge}" Visibility="{Binding Reversible, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource BadgeText}" Text="↺ Reversível" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource BadgeText}" Text="Requer admin" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource BadgeText}" Text="Requer reinício" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Background="Transparent" ToolTip="{Binding ActionsText}" Cursor="Help">
                                <TextBlock Style="{StaticResource BadgeText}" Foreground="{StaticResource TextFaintBrush}" Text="ⓘ O que muda" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Top" Margin="16,2,0,0"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}" ToolTip="Selecionar para aplicar" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentMidBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ───────── Item do histórico ───────── -->
        <DataTemplate x:Key="HistoryTemplate">
            <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ChipButton}" Margin="8,0,0,0" VerticalAlignment="Top"
                            Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}" ToolTip="Desfazer só este item">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="11" Text="&#xE7A7;" Margin="0,0,6,0" />
                            <TextBlock Text="Desfazer" />
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="12" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Details}" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Ellipse Width="6" Height="6" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static safety:JournalStatus.Reverted}">
                                                <Setter Property="Fill" Value="{StaticResource TextFaintBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static safety:JournalStatus.Failed}">
                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" Text="{Binding StatusText}" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" Foreground="{StaticResource TextFaintBrush}" Text="{Binding When, StringFormat=' · {0}'}" />
                        </StackPanel>
                        <TextBlock FontSize="11" Foreground="{StaticResource DangerBrush}" Text="{Binding Error}" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- Cabeçalho -->
        <DockPanel Grid.ColumnSpan="2">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RevertAllCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE7A7;" Margin="0,0,8,0" />
                        <TextBlock Text="Reverter tudo" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ApplySelectedCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" FontSize="13" Foreground="White" Text="&#xE945;" Margin="0,0,8,0" />
                        <TextBlock>
                            <Run Text="Aplicar selecionadas" /><Run Text="{Binding SelectedCount, Mode=OneWay, StringFormat=' ({0})'}" />
                        </TextBlock>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource H1}" Text="Otimizar" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
                    <Run Text="Escolha o que aplicar. Tudo é registrado e pode ser desfeito item a item." />
                    <Run Text="{Binding AppliedCount, Mode=OneWay, StringFormat='{}{0} ativa(s) de'}" Foreground="{StaticResource AccentTextBrush}" />
                    <Run Text="{Binding TotalCount, Mode=OneWay}" Foreground="{StaticResource AccentTextBrush}" />
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- Perfis prontos -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,20,0,16">
            <TextBlock Style="{StaticResource Caption}" Text="PERFIS PRONTOS" VerticalAlignment="Center" Margin="0,0,14,0" />
            <ItemsControl ItemsSource="{Binding Profiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ChipButton}" Command="{Binding DataContext.SelectProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" Content="{Binding Converter={StaticResource ProfileName}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource ChipButton}" Background="Transparent" BorderBrush="Transparent"
                    Foreground="{StaticResource TextMutedBrush}" Command="{Binding SelectNoneCommand}" Content="Limpar seleção" />
            <TextBlock Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"
                       Foreground="{StaticResource AccentTextBrush}" Text="{Binding Status}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="460" />
        </StackPanel>

        <!-- Lista por categoria -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" Margin="2,0,0,10">
                                <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="{Binding Glyph}" Margin="0,0,8,0" />
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding Title}" VerticalAlignment="Center" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TweakTemplate}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Histórico / log de alterações -->
        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0" Padding="14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="2,0,0,12">
                    <TextBlock Style="{StaticResource H2}" FontSize="14" Text="Histórico de alterações" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="11" Text="Passe o mouse sobre um item para ver cada mudança." Margin="0,2,0,0" />
                </StackPanel>
                <Grid>
                    <TextBlock FontSize="12" Text="Nenhuma alteração ainda." HorizontalAlignment="Center" Margin="0,30,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding History.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding History}" ItemTemplate="{StaticResource HistoryTemplate}" />
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Overlay de trabalho -->
        <Border Grid.RowSpan="3" Grid.ColumnSpan="2" Background="#B3000000" CornerRadius="12"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <c:ProgressRing Value="28" Width="40" Height="40" Thickness="4" RenderTransformOrigin="0.5,0.5">
                    <c:ProgressRing.RenderTransform>
                        <RotateTransform x:Name="Spin" />
                    </c:ProgressRing.RenderTransform>
                    <c:ProgressRing.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Spin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </c:ProgressRing.Triggers>
                </c:ProgressRing>
                <TextBlock Style="{StaticResource Body}" Text="{Binding Status}" HorizontalAlignment="Center" Margin="0,14,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
