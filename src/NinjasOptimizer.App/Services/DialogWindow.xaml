<Window x:Class="NinjasOptimizer.App.Services.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="14" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6" Color="#44088C" />
        </Border.Effect>
        <StackPanel Margin="24">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="IconBg" Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentSoftBrush}">
                    <TextBlock x:Name="IconGlyph" Style="{StaticResource Icon}" HorizontalAlignment="Center" Text="&#xE946;" />
                </Border>
                <TextBlock x:Name="TitleText" Style="{StaticResource H2}" Margin="12,0,0,0" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="360" />
            </StackPanel>
            <TextBlock x:Name="MessageText" Style="{StaticResource Muted}" Margin="0,14,0,0" />
            <Border x:Name="DetailsBox" Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="12,8"
                    Margin="0,14,0,0" Visibility="Collapsed">
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="DetailsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Body}" FontSize="12" Margin="0,3" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="Cancelar"
                        Margin="0,0,10,0" Click="OnCancel" IsCancel="True" />
                <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Content="Confirmar"
                        Click="OnConfirm" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
