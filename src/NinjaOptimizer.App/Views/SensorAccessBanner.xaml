<UserControl x:Class="NinjaOptimizer.App.Views.SensorAccessBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NinjaOptimizer.App.Controls">
    <!-- Aviso amarelo do sistema de design. DataContext: LiveSensors -->
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowAccessBanner}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Border Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="1"
            CornerRadius="18" Padding="18,14">
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Button Style="{StaticResource WarningButton}" Content="Abrir como administrador"
                        Command="{Binding ElevateCommand}" Visibility="{Binding CanElevate, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource WarningButton}" Content="Instalar driver"
                        Command="{Binding InstallDriverCommand}" Visibility="{Binding CanInstallDriver, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <c:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.Warning}" Foreground="{StaticResource WarningBrush}"
                    VerticalAlignment="Top" Margin="0,1,12,0" />
            <StackPanel>
                <TextBlock Text="{Binding AccessTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                <TextBlock Text="{Binding AccessMessage}" FontSize="14" LineHeight="21" Foreground="{StaticResource WarningTextBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
