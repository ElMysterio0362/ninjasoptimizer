<UserControl x:Class="NinjaOptimizer.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NinjaOptimizer.App.Controls">
    <UserControl.Resources>
        <Style x:Key="Section" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="24" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,8" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="Configurações" />
            <TextBlock Style="{StaticResource Muted}" Text="Segurança, permissões e dados do app." Margin="0,4,0,24" />

            <!-- Segurança -->
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <StackPanel Style="{StaticResource SectionHeader}">
                        <c:Icon Data="{StaticResource Icon.Shield}" Foreground="{StaticResource AccentTextBrush}" Margin="0,0,10,0" />
                        <TextBlock Style="{StaticResource H3}" Text="Segurança" VerticalAlignment="Center" />
                    </StackPanel>
                    <DockPanel Margin="0,0,0,18">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CreateRestorePoint}" VerticalAlignment="Center"
                                  AutomationProperties.Name="Criar ponto de restauração antes de otimizar" Margin="16,0,0,0" />
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="Criar ponto de restauração antes de otimizar" />
                            <TextBlock Style="{StaticResource Small}" Text="Recomendado. Permite voltar o Windows inteiro ao estado de antes pelo Restaurar sistema." Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AbortIfRestorePointFails}" VerticalAlignment="Center"
                                  AutomationProperties.Name="Cancelar se o ponto de restauração falhar" Margin="16,0,0,0" />
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="Cancelar se o ponto de restauração falhar" />
                            <TextBlock Style="{StaticResource Small}" Text="Desligado, o app segue com o backup do registro e o histórico para desfazer." Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Permissões -->
            <Border Style="{StaticResource Section}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" VerticalAlignment="Center" Content="Abrir como administrador" Command="{Binding RelaunchElevatedCommand}" Margin="16,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsElevated}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <StackPanel>
                        <StackPanel Style="{StaticResource SectionHeader}" Margin="0,0,0,10">
                            <c:Icon Data="{StaticResource Icon.Lock}" Foreground="{StaticResource AccentTextBrush}" Margin="0,0,10,0" />
                            <TextBlock Style="{StaticResource H3}" Text="Permissões" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding ElevationText}" />
                        <TextBlock Style="{StaticResource Small}" Margin="0,2,0,0"
                                   Text="O app abre como usuário comum e só pede administrador quando você aplica algo que precisa. Como administrador, ele também lê as temperaturas da CPU e dos discos." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Fonte de alimentação -->
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <StackPanel Style="{StaticResource SectionHeader}" Margin="0,0,0,10">
                        <c:Icon Data="{StaticResource Icon.Power}" Foreground="{StaticResource AccentTextBrush}" Margin="0,0,10,0" />
                        <TextBlock Style="{StaticResource H3}" Text="Fonte de alimentação" VerticalAlignment="Center" />
                    </StackPanel>
                    <Label Target="{Binding ElementName=PsuBox}" Padding="0" Margin="0,0,0,8" Foreground="{StaticResource TextMutedBrush}" FontSize="13" FontWeight="Medium"
                           Content="Modelo e potência" />
                    <TextBox x:Name="PsuBox" Text="{Binding PowerSupply, UpdateSourceTrigger=LostFocus}" Width="420" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource Label}" Margin="0,8,0,0"
                               Text="Ex.: Corsair RM750x 750 W. A fonte não envia dados ao Windows; usamos esse valor na análise de gargalos." />
                </StackPanel>
            </Border>

            <!-- Dados -->
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <StackPanel Style="{StaticResource SectionHeader}" Margin="0,0,0,10">
                        <c:Icon Data="{StaticResource Icon.Folder}" Foreground="{StaticResource AccentTextBrush}" Margin="0,0,10,0" />
                        <TextBlock Style="{StaticResource H3}" Text="Dados e backups" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Small}" Margin="0,0,0,16"
                               Text="Os backups do registro (.reg) podem ser importados com dois cliques em último caso. O histórico de alterações fica em journal.json." />
                    <WrapPanel>
                        <Button Style="{StaticResource SecondarySmall}" Command="{Binding OpenBackupsCommand}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Data="{StaticResource Icon.Folder}" Size="18" Margin="0,0,8,0" />
                                <TextBlock Text="Abrir backups" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondarySmall}" Command="{Binding OpenDataCommand}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Data="{StaticResource Icon.Folder}" Size="18" Margin="0,0,8,0" />
                                <TextBlock Text="Abrir pasta de dados" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondarySmall}" Command="{Binding OpenLogCommand}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Data="{StaticResource Icon.File}" Size="18" Margin="0,0,8,0" />
                                <TextBlock Text="Abrir log de hoje" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Sobre -->
            <StackPanel Orientation="Horizontal" Margin="4,8,0,0">
                <Path Style="{StaticResource Shuriken}" Width="20" Height="20" />
                <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center">
                    <Run Text="Ninja" FontWeight="Bold" /><Run Text="Optimizer" Style="{StaticResource WordmarkLight}" />
                </TextBlock>
                <TextBlock Style="{StaticResource Label}" Text="{Binding Version, StringFormat='versão {0}'}" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
