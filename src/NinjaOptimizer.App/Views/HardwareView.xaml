<UserControl x:Class="NinjaOptimizer.App.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NinjaOptimizer.App.Controls"
             xmlns:local="clr-namespace:NinjaOptimizer.App.Views">
    <UserControl.Resources>
        <!-- Card de componente: ladrilho + legenda + nome, selo à direita -->
        <Style x:Key="HwCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="22" />
            <Setter Property="Margin" Value="0,0,16,16" />
        </Style>
        <!-- Métrica do grid 2×2 -->
        <DataTemplate x:Key="MetricTemplate">
            <StackPanel Margin="0,0,16,14">
                <TextBlock Style="{StaticResource Label}" Text="{Binding Label}" />
                <TextBlock Style="{StaticResource MetricSmall}" Text="{Binding Value}" Margin="0,2,0,0" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- ───────── Cabeçalho ───────── -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,8,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource Icon.Refresh}" Size="18" Margin="0,0,8,0" />
                        <TextBlock Text="Atualizar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ExportReportCommand}">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource Icon.Export}" Size="18" Margin="0,0,8,0" />
                        <TextBlock Text="Exportar relatório" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Hardware" />
                <TextBlock Style="{StaticResource Muted}" Text="Tudo o que há dentro do seu PC, com sensores ao vivo." Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,8">
                <!-- Selos: Windows, placa-mãe, tempo ligado -->
                <ItemsControl ItemsSource="{Binding Chips}" Margin="0,0,0,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource InfoPill}" Margin="0,0,10,8">
                                <TextBlock Text="{Binding}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <local:SensorAccessBanner DataContext="{Binding Live}" Margin="0,0,0,16" />

                <!-- ───────── Componentes ao vivo ───────── -->
                <UniformGrid Columns="3" Margin="0,0,-16,0">
                    <!-- CPU -->
                    <Border Style="{StaticResource HwCard}">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource KindPill}" VerticalAlignment="Top" Tag="{Binding Live.CpuStatusKind}">
                                    <TextBlock Text="{Binding Live.CpuStatusText}" />
                                </Border>
                                <Border Style="{StaticResource IconTile}" DockPanel.Dock="Left">
                                    <c:Icon Data="{StaticResource Icon.Cpu}" Size="22" HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Caption}" Text="PROCESSADOR" />
                                    <TextBlock Style="{StaticResource H3}" Text="{Binding CpuName}" ToolTip="{Binding CpuName}" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Small}" Text="{Binding CpuDetail}" Margin="0,16,0,16" />
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,16,14">
                                    <TextBlock Style="{StaticResource Label}" Text="{Binding Live.CpuFreqLabel}" />
                                    <TextBlock Style="{StaticResource MetricSmall}" Text="{Binding Live.CpuFreqText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,16,14">
                                    <TextBlock Style="{StaticResource Label}" Text="Temperatura" />
                                    <TextBlock Style="{StaticResource MetricSmall}" Text="{Binding Live.CpuTempText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,16,14">
                                    <TextBlock Style="{StaticResource Label}" Text="Uso" />
                                    <TextBlock Style="{StaticResource MetricSmall}" Text="{Binding Live.CpuLoadText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,16,14">
                                    <TextBlock Style="{StaticResource Label}" Text="Consumo" />
                                    <TextBlock Style="{StaticResource MetricSmall}" Text="{Binding Live.CpuPowerText}" Margin="0,2,0,0" />
                                </StackPanel>
                            </UniformGrid>
                            <ProgressBar Style="{StaticResource SlimBar}" Value="{Binding Live.CpuLoad, Mode=OneWay}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- GPU -->
                    <Border Style="{StaticResource HwCard}">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource KindPill}" VerticalAlignment="Top" Tag="{Binding Live.GpuStatusKind}">
                                    <TextBlock Text="{Binding Live.GpuStatusText}" />
                                </Border>
                                <Border Style="{StaticResource IconTile}" DockPanel.Dock="Left">
                                    <c:Icon Data="{StaticResource Icon.Gpu}" Size="22" HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Caption}" Text="PLACA DE VÍDEO" />
                                    <TextBlock Style="{StaticResource H3}" Text="{Binding GpuName}" ToolTip="{Binding GpuName}" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Small}" Text="{Binding GpuDetail}" Margin="0,16,0,16" />
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,16,14">
                                    <TextBlock Style="{StaticResource Label}" Text="Frequência" />
                                    <TextBlock Style="{StaticResource MetricSmall}" Text="{Binding Live.GpuFreqText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,16,14">
                                    <TextBlock Style="{StaticResource Label}" Text="Temperatura" />
                                    <TextBlock Style="{StaticResource MetricSmall}" Text="{Binding Live.GpuTempText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,16,14">
                                    <TextBlock Style="{StaticResource Label}" Text="Uso" />
                                    <TextBlock Style="{StaticResource MetricSmall}" Text="{Binding Live.GpuLoadText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,16,14">
                                    <TextBlock Style="{StaticResource Label}" Text="Memória de vídeo" />
                                    <TextBlock Style="{StaticResource MetricSmall}" Text="{Binding Live.VramText}" Margin="0,2,0,0" />
                                </StackPanel>
                            </UniformGrid>
                            <ProgressBar Style="{StaticResource SlimBar}" Value="{Binding Live.GpuLoad, Mode=OneWay}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Memória -->
                    <Border Style="{StaticResource HwCard}">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource KindPill}" VerticalAlignment="Top" Tag="{Binding MemChannelKind}">
                                    <TextBlock Text="{Binding MemChannelText}" />
                                </Border>
                                <Border Style="{StaticResource IconTile}" DockPanel.Dock="Left">
                                    <c:Icon Data="{StaticResource Icon.Memory}" Size="22" HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Caption}" Text="MEMÓRIA" />
                                    <TextBlock Style="{StaticResource H3}" Text="{Binding MemTitle}" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Small}" Text="{Binding MemDetail}" Margin="0,16,0,16" />
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,16,14">
                                    <TextBlock Style="{StaticResource Label}" Text="Em uso" />
                                    <TextBlock Style="{StaticResource MetricSmall}" Text="{Binding Live.RamUsedText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,16,14">
                                    <TextBlock Style="{StaticResource Label}" Text="Livre" />
                                    <TextBlock Style="{StaticResource MetricSmall}" Text="{Binding Live.RamFreeText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,16,14">
                                    <TextBlock Style="{StaticResource Label}" Text="Frequência" />
                                    <TextBlock Style="{StaticResource MetricSmall}" Text="{Binding MemSpeedText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,16,14">
                                    <TextBlock Style="{StaticResource Label}" Text="Slots usados" />
                                    <TextBlock Style="{StaticResource MetricSmall}" Text="{Binding MemSlotsText}" Margin="0,2,0,0" />
                                </StackPanel>
                            </UniformGrid>
                            <ProgressBar Style="{StaticResource SlimBar}" Value="{Binding Live.RamLoad, Mode=OneWay}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Discos -->
                <ItemsControl ItemsSource="{Binding Disks}" Margin="0,0,-16,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="3" VerticalAlignment="Top" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource HwCard}">
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource KindPill}" VerticalAlignment="Top" Tag="{Binding StatusKind}">
                                            <TextBlock Text="{Binding StatusText}" />
                                        </Border>
                                        <Border Style="{StaticResource IconTile}" DockPanel.Dock="Left">
                                            <c:Icon Data="{StaticResource Icon.Disk}" Size="22" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="12,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Caption}" />
                                            <TextBlock Style="{StaticResource H3}" Text="{Binding Title}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Small}" Text="{Binding Detail}" Margin="0,16,0,16" />
                                    <ItemsControl ItemsSource="{Binding Metrics}" ItemTemplate="{StaticResource MetricTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ───────── Detalhes ───────── -->
                <TextBlock Style="{StaticResource Caption}" Text="DETALHES" Margin="2,8,0,12" />
                <ItemsControl ItemsSource="{Binding Sections}" Margin="0,0,-16,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,16,16" Padding="22">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <c:Icon Data="{Binding Icon, Converter={StaticResource ResourceKey}}" Foreground="{StaticResource AccentTextBrush}" Margin="0,0,10,0" />
                                        <TextBlock Style="{StaticResource H3}" FontSize="16" Text="{Binding Title}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource Small}" Foreground="{StaticResource TextFaintBrush}" Text="{Binding Label}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                    <TextBlock Grid.Column="1" Style="{StaticResource Small}" Foreground="{StaticResource TextBrush}" FontWeight="Medium" Text="{Binding Value}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Path Style="{StaticResource Spinner}" Width="22" Height="22" />
                    <TextBlock Style="{StaticResource Muted}" Text="Analisando seu PC…" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
