<UserControl x:Class="NinjaOptimizer.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NinjaOptimizer.App.Controls"
             xmlns:local="clr-namespace:NinjaOptimizer.App.Views"
             xmlns:svc="clr-namespace:NinjaOptimizer.App.Services"
             xmlns:vm="clr-namespace:NinjaOptimizer.App.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Card de métrica: ícone + legenda, número grande, detalhe e barra -->
        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,8">
            <!-- ───────── Cabeçalho ───────── -->
            <DockPanel Margin="0,0,0,24">
                <Border DockPanel.Dock="Right" Style="{StaticResource InfoPill}" Margin="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastOptimizationText}" />
                </Border>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Dashboard" />
                    <TextBlock Style="{StaticResource Muted}" Text="Seu PC em números e o que dá para melhorar." Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- ───────── Card principal ───────── -->
            <Border CornerRadius="26" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource SurfaceBrush}">
                <Grid>
                    <Border CornerRadius="26" Background="{StaticResource HeroGlow}" IsHitTestVisible="False" />
                    <Grid Margin="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" MaxWidth="420" />
                        </Grid.ColumnDefinitions>

                        <!-- Anel de pontuação -->
                        <Grid Width="132" Height="132" VerticalAlignment="Center">
                            <Ellipse Stroke="{StaticResource BorderBrush}" StrokeThickness="10" Margin="0" />
                            <c:ProgressRing Value="{Binding OptimizationScore}" Thickness="10" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Metric}" FontSize="34" HorizontalAlignment="Center" Text="{Binding ScoreText}" />
                                <TextBlock Style="{StaticResource Label}" HorizontalAlignment="Center" Text="de 100" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource H2}" Text="{Binding Headline}" />
                            <TextBlock Style="{StaticResource Muted}" Text="{Binding Subline}" Margin="0,10,0,18" MaxWidth="460" HorizontalAlignment="Left" />

                            <!-- Parado: o botão principal da marca -->
                            <Button Style="{StaticResource HeroButton}" HorizontalAlignment="Left" Command="{Binding QuickOptimizeCommand}"
                                    Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Data="{StaticResource Icon.Bolt}" Size="20" Margin="0,0,10,0" />
                                    <TextBlock Text="Otimização rápida" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Otimizando: o shuriken gira -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                <Path Style="{StaticResource Spinner}" Width="28" Height="28" />
                                <TextBlock Style="{StaticResource Muted}" Text="Isso leva menos de um minuto." VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>

                            <!-- Concluído -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                                <Button Style="{StaticResource PrimaryButton}" Content="Ver o que mudou" Command="{Binding SeeChangesCommand}" Margin="0,0,12,0" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Reverter tudo" Command="{Binding RevertAllCommand}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- O que a otimização rápida faz (itens reais do perfil Equilibrado) -->
                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Caption}" Text="O QUE A OTIMIZAÇÃO RÁPIDA FAZ" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding QuickItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" MinHeight="44">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <c:Icon Size="20" Margin="0,0,12,0">
                                                    <c:Icon.Style>
                                                        <Style TargetType="c:Icon" BasedOn="{StaticResource {x:Type c:Icon}}">
                                                            <Setter Property="Data" Value="{StaticResource Icon.Check}" />
                                                            <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Applied}" Value="True">
                                                                    <Setter Property="Data" Value="{StaticResource Icon.CheckCircle}" />
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                    <Setter Property="ToolTip" Value="Já ativo" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </c:Icon.Style>
                                                </c:Icon>
                                                <TextBlock Style="{StaticResource Body}" Text="{Binding Text}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Small}" Text="{Binding QuickMoreText}" Margin="32,10,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <local:SensorAccessBanner DataContext="{Binding Live}" Margin="0,24,0,0" />

            <!-- ───────── Métricas ───────── -->
            <Grid Margin="0,24,-16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource MetricCard}" DataContext="{Binding Live}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <c:Icon Data="{StaticResource Icon.Cpu}" Size="20" Foreground="{StaticResource AccentTextBrush}" Margin="0,0,8,0" />
                            <TextBlock Style="{StaticResource Caption}" Text="CPU" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Metric}"><Run Text="{Binding CpuLoadNumber, Mode=OneWay}" /><Run Text="%" Style="{StaticResource MetricUnit}" /></TextBlock>
                        <TextBlock Style="{StaticResource Small}" Text="{Binding CpuSubline}" Margin="0,4,0,12" />
                        <ProgressBar Style="{StaticResource SlimBar}" Value="{Binding CpuLoad, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource MetricCard}" DataContext="{Binding Live}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <c:Icon Data="{StaticResource Icon.Gpu}" Size="20" Foreground="{StaticResource AccentTextBrush}" Margin="0,0,8,0" />
                            <TextBlock Style="{StaticResource Caption}" Text="GPU" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Metric}"><Run Text="{Binding GpuLoadNumber, Mode=OneWay}" /><Run Text="%" Style="{StaticResource MetricUnit}" /></TextBlock>
                        <TextBlock Style="{StaticResource Small}" Text="{Binding GpuSubline}" Margin="0,4,0,12" />
                        <ProgressBar Style="{StaticResource SlimBar}" Value="{Binding GpuLoad, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <c:Icon Data="{StaticResource Icon.Memory}" Size="20" Foreground="{StaticResource AccentTextBrush}" Margin="0,0,8,0" />
                            <TextBlock Style="{StaticResource Caption}" Text="MEMÓRIA" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Metric}"><Run Text="{Binding Live.RamUsedNumber, Mode=OneWay}" /><Run Text=" GB" Style="{StaticResource MetricUnit}" /></TextBlock>
                        <TextBlock Style="{StaticResource Small}" Margin="0,4,0,12">
                            <Run Text="{Binding Live.RamTotalText, Mode=OneWay}" /><Run Text="{Binding RamTypeText, Mode=OneWay}" />
                        </TextBlock>
                        <ProgressBar Style="{StaticResource SlimBar}" Value="{Binding Live.RamLoad, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <c:Icon Data="{StaticResource Icon.Disk}" Size="20" Foreground="{StaticResource AccentTextBrush}" Margin="0,0,8,0" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding SystemDriveLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Metric}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SystemDriveAlmostFull}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="{Binding SystemDriveNumber, Mode=OneWay}" /><Run Text="%" Style="{StaticResource MetricUnit}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Small}" Text="{Binding SystemDriveDetail}" Margin="0,4,0,12" />
                        <ProgressBar Value="{Binding SystemDrivePercent, Mode=OneWay}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar" BasedOn="{StaticResource SlimBar}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SystemDriveAlmostFull}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ───────── Gráfico + recomendações ───────── -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="24">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="14" Height="3" CornerRadius="2" Background="{StaticResource AccentTextBrush}" Margin="0,0,6,0" />
                                <TextBlock Style="{StaticResource Label}" Foreground="{StaticResource TextMutedBrush}" Text="CPU" Margin="0,0,16,0" />
                                <Line X1="0" X2="14" Y1="1" Y2="1" Stroke="{StaticResource InfoBrush}" StrokeThickness="2" StrokeDashArray="1.5 1" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Style="{StaticResource Label}" Foreground="{StaticResource TextMutedBrush}" Text="GPU" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource H3}" Text="Uso nos últimos 60 segundos" />
                        </DockPanel>
                        <c:UsageChart Height="190" Primary="{Binding Live.CpuHistory}" Secondary="{Binding Live.GpuHistory}"
                                      AutomationProperties.Name="Uso de CPU e GPU nos últimos 60 segundos" />
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H3}" Text="Recomendações" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Recommendations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:Recommendation}">
                                    <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" MinHeight="60">
                                        <DockPanel VerticalAlignment="Center" Margin="0,8">
                                            <Button DockPanel.Dock="Right" Command="{Binding Action}" Content="{Binding ActionText}" Margin="12,0,0,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SecondarySmall}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static svc:StatusKind.Warning}">
                                                                <Setter Property="Background" Value="#1FFFB547" />
                                                                <Setter Property="BorderBrush" Value="#80FFB547" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Body}" FontWeight="Medium" Text="{Binding Title}" />
                                                <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static svc:StatusKind.Accent}">
                                                                    <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static svc:StatusKind.Warning}">
                                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasRecommendations}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <c:Icon Data="{StaticResource Icon.CheckCircle}" Foreground="{StaticResource SuccessBrush}" Margin="0,0,10,0" />
                            <TextBlock Style="{StaticResource Muted}" Text="Nada pendente. Seu PC está em dia." VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
