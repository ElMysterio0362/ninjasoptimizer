<UserControl x:Class="NinjaOptimizer.App.Views.OptimizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NinjaOptimizer.App.Controls"
             xmlns:safety="clr-namespace:NinjaOptimizer.Core.Safety;assembly=NinjaOptimizer.Core">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- ───────── Linha de um ajuste ───────── -->
        <DataTemplate x:Key="TweakRow">
            <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,14">
                <DockPanel>
                    <!-- Ladrilho do ícone: roxo quando selecionado -->
                    <Border DockPanel.Dock="Left" VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource IconTile}">
                                <Setter Property="Background" Value="{StaticResource Surface3Brush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="TextElement.Foreground" Value="{StaticResource TextFaintBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentSoftBorderBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource AccentTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <c:Icon Data="{Binding Icon, Converter={StaticResource ResourceKey}}" Size="22" HorizontalAlignment="Center" />
                    </Border>

                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="16,0,0,0"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Name}"
                              ToolTip="Selecionar para aplicar" />

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource KindPill}" Tag="{Binding AppliedKind}" Margin="8,0,0,0" Visibility="{Binding IsApplied, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Data="{StaticResource Icon.Check}" Size="13" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding AppliedText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KindPill}" Tag="{Binding RiskKind}" Margin="8,0,0,0">
                            <TextBlock Text="{Binding RiskText}" />
                        </Border>
                        <Border Style="{StaticResource KindPill}" Tag="{Binding ImpactKind}" Margin="8,0,0,0">
                            <TextBlock Text="{Binding ImpactText}" />
                        </Border>
                        <Border Background="Transparent" Margin="10,0,0,0" ToolTip="{Binding ActionsText}" Cursor="Help"
                                ToolTipService.ShowDuration="60000" AutomationProperties.Name="O que muda">
                            <c:Icon Data="{StaticResource Icon.Info}" Size="18" Foreground="{StaticResource TextFaintBrush}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Margin="16,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Small}" LineHeight="18" Text="{Binding Description}" Margin="0,2,0,0" />
                        <TextBlock Style="{StaticResource Small}" FontSize="12" Foreground="{StaticResource AccentTextBrush}" Text="{Binding Benefit}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

        </DataTemplate>

        <!-- ───────── Linha de limpeza/manutenção ───────── -->
        <DataTemplate x:Key="CleanupRow">
            <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,14">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" VerticalAlignment="Top">
                        <c:Icon Data="{Binding Icon, Converter={StaticResource ResourceKey}}" Size="22" HorizontalAlignment="Center" />
                    </Border>
                    <Grid DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="150">
                        <Button Style="{StaticResource SecondarySmall}" Content="{Binding ActionText}" HorizontalAlignment="Right"
                                Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVis}}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                            <Path Style="{StaticResource Spinner}" Width="22" Height="22" />
                            <TextBlock Style="{StaticResource Small}" Text="Executando…" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Border DockPanel.Dock="Right" Style="{StaticResource KindPill}" Tag="{Binding EstimateKind}" Margin="8,0,0,0">
                        <Border.Visibility>
                            <Binding Path="EstimateText" Converter="{StaticResource EmptyToCollapsed}" />
                        </Border.Visibility>
                        <TextBlock Text="{Binding EstimateText}" />
                    </Border>
                    <StackPanel Margin="16,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Small}" LineHeight="18" Text="{Binding Description}" Margin="0,2,0,0" />
                        <TextBlock Style="{StaticResource Small}" FontSize="12" Foreground="{StaticResource WarningBrush}" Text="{Binding Note}" Margin="0,4,0,0"
                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Style="{StaticResource Label}" Margin="0,6,0,0">
                            <Run Text="{Binding DurationText, Mode=OneWay}" /><Run Text="{Binding LastRunText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- ───────── Item do histórico ───────── -->
        <DataTemplate x:Key="HistoryTemplate">
            <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondarySmall}" Height="36" Padding="12,0" Margin="8,0,0,0" VerticalAlignment="Center"
                            Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}" ToolTip="Desfazer só este ajuste">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource Icon.Undo}" Size="16" Margin="0,0,6,0" />
                            <TextBlock Text="Desfazer" FontSize="13" />
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static safety:JournalStatus.Reverted}">
                                                <Setter Property="Fill" Value="{StaticResource TextFaintBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static safety:JournalStatus.Failed}">
                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Style="{StaticResource Label}" Foreground="{StaticResource TextMutedBrush}" Text="{Binding StatusText}" />
                            <TextBlock Style="{StaticResource Label}" Text="{Binding When, StringFormat=' · {0}'}" />
                        </StackPanel>
                        <TextBlock FontSize="12" Foreground="{StaticResource DangerBrush}" Text="{Binding Error}" TextWrapping="Wrap" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- ───────── Cabeçalho ───────── -->
        <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,20">
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom"
                    Command="{Binding Cleanup.AnalyzeCommand}" Visibility="{Binding ShowCleanup, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <c:Icon Data="{StaticResource Icon.Refresh}" Size="18" Margin="0,0,8,0" />
                    <TextBlock Text="Analisar de novo" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom"
                        Visibility="{Binding ShowCleanup, Converter={StaticResource InverseBoolToVis}}">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RevertAllCommand}" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource Icon.Undo}" Size="18" Margin="0,0,8,0" />
                        <TextBlock Text="Reverter tudo" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ApplySelectedCommand}" Padding="24,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCount}" Value="0">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock>
                        <Run Text="Aplicar selecionadas" /><Run Text="{Binding SelectedCount, Mode=OneWay, StringFormat=' ({0})'}" />
                    </TextBlock>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Otimizar" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
                    <Run Text="Escolha o que o NinjaOptimizer ajusta no seu PC." />
                    <Run Text="{Binding AppliedCount, Mode=OneWay}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" /><Run Text=" de " Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" /><Run Text="{Binding TotalCount, Mode=OneWay}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                    <Run Text="ativas." />
                </TextBlock>
                <TextBlock Foreground="{StaticResource WarningBrush}" Margin="0,4,0,0"
                           Text="{Binding PendingRestartCount, StringFormat='{}{0} ajuste(s) esperando você sair e entrar de novo na conta (ou reiniciar o PC) para valer.'}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Small}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PendingRestartCount}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- ───────── Filtro por categoria + perfis prontos ───────── -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,8">
            <WrapPanel Margin="0,0,0,12">
                <RadioButton Style="{StaticResource TabPill}" GroupName="OptimizeTab" IsChecked="{Binding ShowTweaks, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource Icon.Bolt}" Size="18" Margin="0,0,8,0" />
                        <TextBlock Text="Ajustes" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource TabPill}" GroupName="OptimizeTab" IsChecked="{Binding ShowCleanup, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource Icon.Broom}" Size="18" Margin="0,0,8,0" />
                        <TextBlock Text="Limpeza e manutenção" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </WrapPanel>
            <StackPanel Visibility="{Binding ShowCleanup, Converter={StaticResource InverseBoolToVis}}">
            <ItemsControl ItemsSource="{Binding Filters}" AutomationProperties.Name="Filtrar por categoria">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource TabPill}" GroupName="CategoryFilter"
                                     Content="{Binding Title}" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel Margin="0,4,0,0">
                <TextBlock Style="{StaticResource Caption}" Text="MOSTRAR" VerticalAlignment="Center" Margin="0,0,14,8" />
                <ItemsControl ItemsSource="{Binding StatusFilters}" AutomationProperties.Name="Filtrar por status">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource TabPill}" GroupName="StatusFilter" Height="36" Padding="14,0"
                                         Content="{Binding Title}" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </WrapPanel>
            <WrapPanel Margin="0,4,0,0">
                <TextBlock Style="{StaticResource Caption}" Text="PERFIS PRONTOS" VerticalAlignment="Center" Margin="0,0,14,8" />
                <ItemsControl ItemsSource="{Binding Profiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ChipButton}" Command="{Binding DataContext.SelectProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" Content="{Binding Converter={StaticResource ProfileName}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource ChipButton}" Command="{Binding SelectNoneCommand}" Content="Limpar seleção" />
                <TextBlock Style="{StaticResource Small}" Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Center"
                           Margin="6,0,0,8" Text="{Binding Status}" />
            </WrapPanel>
            </StackPanel>
        </StackPanel>

        <!-- ───────── Limpeza e manutenção ───────── -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True"
                Visibility="{Binding ShowCleanup, Converter={StaticResource BoolToVis}}" DataContext="{Binding Cleanup}">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,14">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource Icon.Disk}" Foreground="{StaticResource AccentTextBrush}" Margin="0,0,10,0" />
                        <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding TotalText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource CleanupRow}" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ───────── Lista ───────── -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True"
                Visibility="{Binding ShowCleanup, Converter={StaticResource InverseBoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding VisibleItems}" ItemTemplate="{StaticResource TweakRow}" />
                    <TextBlock Style="{StaticResource Muted}" Text="Nenhum ajuste com esse filtro." HorizontalAlignment="Center" Margin="0,40"
                               Visibility="{Binding IsFilterEmpty, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3" Style="{StaticResource Small}" Foreground="{StaticResource TextFaintBrush}" Margin="2,12,0,0" MaxWidth="640" HorizontalAlignment="Left"
                   Visibility="{Binding ShowCleanup, Converter={StaticResource BoolToVis}}"
                   Text="A limpeza não tem como desfazer: cada item diz o que apaga antes de rodar." />
        <TextBlock Grid.Row="3" Style="{StaticResource Small}" Foreground="{StaticResource TextFaintBrush}" Margin="2,12,0,0" MaxWidth="640" HorizontalAlignment="Left"
                   Visibility="{Binding ShowCleanup, Converter={StaticResource InverseBoolToVis}}"
                   Text="Todos os ajustes podem ser revertidos. Antes de aplicar, o app cria um ponto de restauração do Windows." />

        <!-- ───────── Histórico de alterações ───────── -->
        <Border Grid.Row="2" Grid.RowSpan="2" Grid.Column="2" Style="{StaticResource Card}" Padding="20,18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource H3}" Text="Histórico de alterações" />
                    <TextBlock Style="{StaticResource Label}" Text="Passe o mouse num item para ver cada mudança." Margin="0,4,0,0" />
                </StackPanel>
                <Grid>
                    <StackPanel HorizontalAlignment="Center" Margin="0,32,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding History.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <c:Icon Data="{StaticResource Icon.Clock}" Size="28" Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource Small}" Text="Nenhuma alteração ainda." Margin="0,10,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding History}" ItemTemplate="{StaticResource HistoryTemplate}" />
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ───────── Trabalhando: o shuriken gira ───────── -->
        <Border Grid.RowSpan="4" Grid.ColumnSpan="3" Background="#CC07060B" CornerRadius="22"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Style="{StaticResource Spinner}" Width="48" Height="48" HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource Body}" Text="{Binding Status}" HorizontalAlignment="Center" Margin="0,16,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
