<UserControl x:Class="NinjaOptimizer.App.Views.BenchmarkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NinjaOptimizer.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ───────── Cabeçalho ───────── -->
        <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Style="{StaticResource PrimaryButton}" Padding="24,0" Command="{Binding RunCommand}">
                    <Button.Visibility>
                        <Binding Path="IsRunning" Converter="{StaticResource InverseBoolToVis}" />
                    </Button.Visibility>
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource Icon.Benchmark}" Size="18" Margin="0,0,8,0" />
                        <TextBlock Text="Rodar benchmark" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Content="Cancelar" Command="{Binding CancelCommand}"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Benchmark" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                           Text="Mede CPU, memória e disco. Rode antes e depois das otimizações para ver a diferença." />
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,8">
                <!-- ───────── Rodando ───────── -->
                <Border Style="{StaticResource Panel}" Margin="0,0,0,16" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Spinner}" Width="32" Height="32" />
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource H3}" Text="{Binding Step, StringFormat='Medindo: {0}'}" />
                                <TextBlock Style="{StaticResource Small}" Text="Leva cerca de 1 minuto. Para um resultado justo, não use o PC enquanto mede." Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <ProgressBar Style="{StaticResource SlimBar}" Height="8" Value="{Binding Progress, Mode=OneWay}" Margin="0,20,0,0" />
                    </StackPanel>
                </Border>

                <!-- ───────── Vazio ───────── -->
                <Border Style="{StaticResource Panel}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Border Style="{StaticResource IconTile}" HorizontalAlignment="Left">
                            <c:Icon Data="{StaticResource Icon.Benchmark}" Size="22" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Style="{StaticResource H2}" Text="Meça o desempenho do seu PC" Margin="0,16,0,8" />
                        <TextBlock Style="{StaticResource Muted}" MaxWidth="560" HorizontalAlignment="Left"
                                   Text="Rode uma vez agora, como referência. Depois aplique otimizações, reinicie se o app pedir, e rode de novo: mostramos o que mudou em cada teste." />
                        <TextBlock Style="{StaticResource Small}" Margin="0,12,0,0"
                                   Text="O teste de disco grava e apaga um arquivo temporário de 256 MB." />
                    </StackPanel>
                </Border>

                <!-- ───────── Resultado ───────── -->
                <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                    <Border CornerRadius="26" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource SurfaceBrush}" Margin="0,0,0,16">
                        <Grid>
                            <Border CornerRadius="26" Background="{StaticResource HeroGlow}" IsHitTestVisible="False" />
                            <DockPanel Margin="32,28">
                                <StackPanel DockPanel.Dock="Left" Margin="0,0,32,0">
                                    <TextBlock Style="{StaticResource Caption}" Text="PONTUAÇÃO GERAL" />
                                    <TextBlock Style="{StaticResource Metric}" FontSize="44" Foreground="{StaticResource AccentTextBrush}" Text="{Binding OverallText}" />
                                    <Border Style="{StaticResource KindPill}" Tag="{Binding OverallChangeKind}" HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <Border.Visibility>
                                            <Binding Path="OverallChangeText" Converter="{StaticResource EmptyToCollapsed}" />
                                        </Border.Visibility>
                                        <TextBlock Text="{Binding OverallChangeText}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource H2}" Text="{Binding Headline}" />
                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding BaselineText}" Margin="0,8,0,0" />
                                    <TextBlock Style="{StaticResource Small}" Foreground="{StaticResource TextFaintBrush}" Margin="0,8,0,0"
                                               Text="1.000 pontos = PC de referência (Ryzen 5 3600, DDR4-3200 em dual channel, SSD NVMe PCIe 3.0)." />
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Cards}" Margin="0,0,-16,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,16,16">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Style="{StaticResource KindPill}" Tag="{Binding ChangeKind}" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding ChangeText}" />
                                            </Border>
                                            <c:Icon Data="{Binding Icon, Converter={StaticResource ResourceKey}}" Foreground="{StaticResource AccentTextBrush}" Margin="0,0,8,0" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Metric}" Margin="0,14,0,0">
                                            <Run Text="{Binding ValueText, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Unit, Mode=OneWay}" Style="{StaticResource MetricUnit}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Small}" Text="{Binding Detail}" Margin="0,4,0,0">
                                            <TextBlock.Visibility>
                                                <Binding Path="Detail" Converter="{StaticResource EmptyToCollapsed}" />
                                            </TextBlock.Visibility>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Small}" Foreground="{StaticResource AccentTextBrush}" Text="{Binding ScoreText}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ───────── Histórico ───────── -->
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Padding="20,18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource H3}" Text="Histórico" />
                    <TextBlock Style="{StaticResource Label}" Text="Escolha uma medição como base para comparar." Margin="0,4,0,0" />
                </StackPanel>
                <Grid>
                    <StackPanel HorizontalAlignment="Center" Margin="0,32,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding History.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <c:Icon Data="{StaticResource Icon.Clock}" Size="28" Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource Small}" Text="Nenhuma medição ainda." Margin="0,10,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" Width="32" Height="32" ToolTip="Excluir"
                                                        AutomationProperties.Name="Excluir medição"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <c:Icon Data="{StaticResource Icon.Close}" Size="14" />
                                                </Button>
                                                <StackPanel>
                                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding OverallText}" />
                                                    <TextBlock Style="{StaticResource Label}" Margin="0,2,0,0">
                                                        <Run Text="{Binding When, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding TweaksText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                            <WrapPanel Margin="0,8,0,0">
                                                <Border Style="{StaticResource PillAccent}" Margin="0,0,8,0" Visibility="{Binding IsShown, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Exibindo" />
                                                </Border>
                                                <Border Style="{StaticResource Pill}" Margin="0,0,8,0" Visibility="{Binding IsBaseline, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Base" />
                                                </Border>
                                                <Button Style="{StaticResource SecondarySmall}" Height="32" Padding="12,0" Margin="0,0,8,0" Content="Ver"
                                                        Visibility="{Binding IsShown, Converter={StaticResource InverseBoolToVis}}"
                                                        Command="{Binding DataContext.ShowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource SecondarySmall}" Height="32" Padding="12,0" Content="Usar como base">
                                                    <Button.Visibility>
                                                        <MultiBinding Converter="{StaticResource AllFalseToVis}">
                                                            <Binding Path="IsShown" />
                                                            <Binding Path="IsBaseline" />
                                                        </MultiBinding>
                                                    </Button.Visibility>
                                                    <Button.Command>
                                                        <Binding Path="DataContext.SetBaselineCommand" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    </Button.Command>
                                                    <Button.CommandParameter>
                                                        <Binding />
                                                    </Button.CommandParameter>
                                                </Button>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
