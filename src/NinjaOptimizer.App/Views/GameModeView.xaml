<UserControl x:Class="NinjaOptimizer.App.Views.GameModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NinjaOptimizer.App.Controls"
             xmlns:vm="clr-namespace:NinjaOptimizer.App.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <DataTemplate x:Key="AppRow">
            <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,12">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="16,0,0,0"
                              IsChecked="{Binding Pause, Mode=TwoWay}" ToolTip="Pausar durante o jogo" AutomationProperties.Name="{Binding Name}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondarySmall}" Height="32" Padding="12,0" VerticalAlignment="Center"
                            Content="É um jogo" ToolTip="Ligar o Modo Gamer quando este programa abrir"
                            Command="{Binding DataContext.MarkAsGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                        <TextBlock Style="{StaticResource Label}" Margin="0,3,0,0" Text="{Binding MemoryText}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,20">
            <TextBlock Style="{StaticResource PageTitle}" Text="Modo Gamer" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                       Text="Pausa programas em segundo plano enquanto você joga e devolve tudo ao normal quando o jogo fecha." />
        </StackPanel>

        <!-- Estado -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="24,20" Margin="0,0,0,16">
            <DockPanel>
                <Button DockPanel.Dock="Right" VerticalAlignment="Center" Padding="24,0" Command="{Binding ToggleCommand}" Margin="16,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Content" Value="Ligar agora" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Content" Value="Desligar e retomar tudo" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" VerticalAlignment="Center">
                    <c:Icon Data="{StaticResource Icon.Gamepad}" Size="22" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource H3}" Text="{Binding StatusTitle}" />
                    <TextBlock Style="{StaticResource Small}" Text="{Binding StatusText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Programas em segundo plano -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,14">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondarySmall}" Height="32" Padding="12,0" Command="{Binding RefreshAppsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Data="{StaticResource Icon.Refresh}" Size="16" Margin="0,0,6,0" />
                                <TextBlock Text="Atualizar" FontSize="13" />
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondarySmall}" Height="32" Padding="12,0" Margin="0,0,8,0"
                                Content="Lista padrão" Command="{Binding RestoreDefaultsCommand}" ToolTip="Volta a lista de pausa para a sugerida pelo NinjaOptimizer" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="Programas abertos" />
                            <TextBlock Style="{StaticResource Label}" Text="{Binding PauseSummary}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource AppRow}" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Lateral: automático + meus jogos -->
        <ScrollViewer Grid.Row="2" Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,4,0">
            <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,16">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoActivate}" VerticalAlignment="Center"
                              Margin="12,0,0,0" AutomationProperties.Name="Ligar sozinho quando um jogo abrir" />
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="Ligar sozinho" />
                        <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="Detecta jogos da Steam, Epic, Riot, GOG, Xbox, Battle.net, Ubisoft e EA, mais os da sua lista." />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="20,18">
                <StackPanel>
                    <TextBlock Style="{StaticResource H3}" Text="Meus jogos" />
                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,12"
                               Text="Para jogos fora das lojas: digite o nome do .exe ou use &quot;É um jogo&quot; na lista." />
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondarySmall}" Height="36" Padding="12,0" Margin="8,0,0,0"
                                Content="Adicionar" Command="{Binding AddNewGameCommand}" />
                        <TextBox Text="{Binding NewGame, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Height="36"
                                 AutomationProperties.Name="Nome do executável do jogo" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding UserGames}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,6,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondarySmall}" Height="28" Padding="10,0" Content="Remover"
                                            Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Small}" Text="Nenhum jogo adicionado." Margin="0,6,0,0"
                               Visibility="{Binding HasUserGames, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H3}" Text="Durante o jogo" />
                    <DockPanel Margin="0,12,0,0">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoPurgeStandby}" VerticalAlignment="Top"
                                  Margin="12,0,0,0" AutomationProperties.Name="Limpar a memória em espera automaticamente" />
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Limpar a memória em espera sozinho" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Small}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="Verifica a cada 5 s só com o Modo Gamer ligado. Limpa quando os dois limites abaixo valem." />
                            <TextBlock Style="{StaticResource Small}" FontSize="12" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,2,0,0" Text="{Binding PurgeConsequences}" />
                        </StackPanel>
                    </DockPanel>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Small}" VerticalAlignment="Center" Text="Em espera acima de (MB)" />
                        <TextBox Grid.Column="1" Height="30" Margin="0,2" Text="{Binding StandbyThresholdMb, UpdateSourceTrigger=LostFocus}"
                                 AutomationProperties.Name="Limite da memória em espera em MB" />
                        <TextBlock Grid.Row="1" Style="{StaticResource Small}" VerticalAlignment="Center" Text="e livre abaixo de (MB)" />
                        <TextBox Grid.Row="1" Grid.Column="1" Height="30" Margin="0,2" Text="{Binding FreeThresholdMb, UpdateSourceTrigger=LostFocus}"
                                 AutomationProperties.Name="Limite da memória livre em MB" />
                    </Grid>
                    <DockPanel Margin="0,14,0,0">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HighResolutionTimer}" VerticalAlignment="Top"
                                  Margin="12,0,0,0" AutomationProperties.Name="Timer de alta resolução durante o jogo" />
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Timer de alta resolução (0,5 ms)" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Small}" FontSize="12" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,2,0,0" Text="{Binding TimerConsequences}" />
                            <TextBlock Style="{StaticResource Small}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" Text="{Binding TimerHint}"
                                       Visibility="{Binding TimerHint, Converter={StaticResource EmptyToCollapsed}}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H3}" Text="Prioridade de CPU" />
                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,12"
                               Text="O Windows passa a abrir o jogo com mais prioridade que os outros programas. Vale na próxima vez que ele abrir. Ajuda em jogo limitado pela CPU." />
                    <ItemsControl ItemsSource="{Binding Priorities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Exe}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <ComboBox Margin="0,4,0,0" Height="34" ItemsSource="{Binding Source={x:Static vm:GamePriorityItem.Options}}"
                                              SelectedItem="{Binding Selected, Mode=TwoWay}" DisplayMemberPath="Title"
                                              AutomationProperties.Name="{Binding Exe}" />
                                    <TextBlock Style="{StaticResource Small}" FontSize="12" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="{Binding Note}" Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap" Text="Abra um jogo ou adicione em &quot;Meus jogos&quot; para ele aparecer aqui."
                               Visibility="{Binding HasPriorities, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Small}" Foreground="{StaticResource TextFaintBrush}" TextWrapping="Wrap" Margin="2,12,0,0"
                       Text="Partes do Windows, antivírus, áudio, drivers de vídeo e anti-cheat nunca são pausados. Se o app fechar no meio, ele retoma tudo ao abrir de novo." />
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
