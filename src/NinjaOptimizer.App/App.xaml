<Application x:Class="NinjaOptimizer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NinjaOptimizer.App.Controls"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Colors.xaml" />
                <ResourceDictionary Source="Theme/Icons.xaml" />
                <ResourceDictionary Source="Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <c:ProfileNameConverter x:Key="ProfileName" />
            <c:ResourceKeyConverter x:Key="ResourceKey" />
            <c:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <c:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
            <c:AllFalseToVisibilityConverter x:Key="AllFalseToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
