<Window x:Class="NinjaOptimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NinjaOptimizer.App.ViewModels"
        xmlns:views="clr-namespace:NinjaOptimizer.App.Views"
        xmlns:c="clr-namespace:NinjaOptimizer.App.Controls"
        Title="NinjaOptimizer" Width="1320" Height="860" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        Icon="Assets/app.ico" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OptimizeViewModel}"><views:OptimizeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HardwareViewModel}"><views:HardwareView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}"><views:PlaceholderView /></DataTemplate>

        <!-- Item do menu: ícone 20 px (Roxo 300 quando ativo) + 12 px + texto -->
        <DataTemplate x:Key="NavTemplate" DataType="{x:Type vm:NavItem}">
            <StackPanel Orientation="Horizontal">
                <c:Icon x:Name="NavIcon" Data="{Binding Icon, Converter={StaticResource ResourceKey}}" Size="20" Margin="0,0,12,0" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="NavIcon" Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="NavList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource NavButton}" />
            <Setter Property="ItemTemplate" Value="{StaticResource NavTemplate}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ───────── Menu lateral ───────── -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="26" Margin="12,12,0,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.55" Color="#000000" />
            </Border.Effect>
            <DockPanel Margin="14,18,14,16">
                <!-- Logo horizontal: símbolo + wordmark -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,6,10,24">
                    <Path Style="{StaticResource Shuriken}" Width="26" Height="26" />
                    <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="17" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Run Text="Ninja" FontWeight="Bold" /><Run Text="Optimizer" Style="{StaticResource WordmarkLight}" />
                    </TextBlock>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <ListBox x:Name="FooterList" Style="{StaticResource NavList}" ItemsSource="{Binding FooterItems}"
                             SelectionChanged="OnNavSelectionChanged" AutomationProperties.Name="Configurações" />
                    <StackPanel Orientation="Horizontal" Margin="12,10,0,0">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource TextFaintBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsElevated}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Style="{StaticResource Label}" Text="{Binding FooterText}" TextWrapping="Wrap" MaxWidth="190" />
                    </StackPanel>
                </StackPanel>

                <ListBox x:Name="MainList" Style="{StaticResource NavList}" ItemsSource="{Binding NavItems}"
                         SelectionChanged="OnNavSelectionChanged" AutomationProperties.Name="Navegação principal" />
            </DockPanel>
        </Border>

        <!-- ───────── Conteúdo ───────── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,4,8,0"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Click="OnMinimize" ToolTip="Minimizar" AutomationProperties.Name="Minimizar">
                    <c:Icon Data="{StaticResource Icon.Minimize}" Size="18" />
                </Button>
                <Button Style="{StaticResource CaptionButton}" Click="OnMaximize" ToolTip="Maximizar" AutomationProperties.Name="Maximizar">
                    <c:Icon Data="{StaticResource Icon.Maximize}" Size="16" />
                </Button>
                <Button Style="{StaticResource CloseCaptionButton}" Click="OnClose" ToolTip="Fechar" AutomationProperties.Name="Fechar">
                    <c:Icon Data="{StaticResource Icon.Close}" Size="18" />
                </Button>
            </StackPanel>

            <ContentControl x:Name="PageHost" Grid.Row="1" Margin="28,0,24,24" Focusable="False"
                            Content="{Binding Current.Page, NotifyOnTargetUpdated=True}">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="PageOffset" />
                </ContentControl.RenderTransform>
                <ContentControl.Triggers>
                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" />
                                <DoubleAnimation Storyboard.TargetName="PageOffset" Storyboard.TargetProperty="Y" From="10" To="0" Duration="0:0:0.28">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </ContentControl.Triggers>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
