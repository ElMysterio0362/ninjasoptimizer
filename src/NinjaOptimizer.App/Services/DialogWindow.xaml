<Window x:Class="NinjaOptimizer.App.Services.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:NinjaOptimizer.App.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="Height" Width="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}" UseLayoutRounding="True">
    <!-- Diálogo do sistema de design: Superfície 2, borda forte, raio 16 -->
    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="22" Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="14" Direction="270" Opacity="0.75" Color="#000000" />
        </Border.Effect>
        <StackPanel Margin="24">
            <DockPanel>
                <Border x:Name="IconBg" DockPanel.Dock="Left" Style="{StaticResource IconTile}" VerticalAlignment="Top">
                    <c:Icon x:Name="IconGlyph" Data="{StaticResource Icon.Info}" Size="22" HorizontalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TitleText" Style="{StaticResource H3}" TextWrapping="Wrap" TextTrimming="None"
                           Margin="14,0,0,0" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock x:Name="MessageText" Style="{StaticResource Muted}" Margin="0,16,0,0" />
            <Border x:Name="DetailsBox" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="14,8" Margin="0,16,0,0" Visibility="Collapsed">
                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="DetailsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Small}" Foreground="{StaticResource TextBrush}" Text="{Binding}" Margin="0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="Cancelar"
                        Margin="0,0,12,0" Click="OnCancel" IsCancel="True" />
                <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Content="Confirmar"
                        Click="OnConfirm" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
